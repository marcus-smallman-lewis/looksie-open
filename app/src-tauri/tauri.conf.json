{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Looksie",
  "version": "1.0.0",
  "identifier": "dev.looksie.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Looksie",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 560,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Have a proper looksie at big pull requests",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBRkE5NzI2MzFBRjU4QjkKUldTNVdLOHhKcGY2aWdOZDlKU3dIRWs4dlNyck9LbkFCWllsZTNKWld4aVdSOGEyUjNqZnUvL24K",
      "endpoints": [
        "https://github.com/marcus-smallman-lewis/looksie-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
